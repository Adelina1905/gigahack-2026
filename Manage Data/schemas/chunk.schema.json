{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://municipal-assistant.local/schemas/chunk.schema.json",
  "title": "Municipal retrieval chunk",
  "type": "object",
  "required": ["schemaVersion", "chunkId", "evidenceId", "documentId", "versionId", "documentType", "language", "text", "retrievalText", "citationText", "evidenceKind", "sourceLocator", "citations", "facts", "quality", "metadata", "indexingStatus"],
  "properties": {
    "chunkId": {"type": "string"},
    "evidenceId": {"type": "string"},
    "versionId": {"type": "string"},
    "documentId": {"type": "string"},
    "documentType": {"type": "string"},
    "language": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "citationText": {"type": "string", "minLength": 1},
    "retrievalText": {"type": "string", "minLength": 1},
    "evidenceKind": {"enum": ["body", "list", "table", "headline"]},
    "sourceLocator": {"type": "object"},
    "quality": {"type": "object"},
    "facts": {"type": "object"},
    "citations": {"type": "array", "minItems": 1},
    "metadata": {"type": "object"},
    "indexingStatus": {"enum": ["READY", "CITATION_PENDING", "NEEDS_REVIEW"]}
  }
}
