  "guardrails": {
    "screenPassages": 16,
    "screenQuoteChars": 700,
    "categoryPenalty": 0.85,
    "recencyDays": 365,
    "historyTurns": 3
  },
  "chunking": {
    "targetMinTokens": 180,
    "targetMaxTokens": 320,
    "hardMaxTokens": 420,
    "sentenceOverlap": 1
  }
}
