{
  "schemaVersion": "3.0",
  "promptVersion": "municipal-hybrid-planner-v4.0",
  "models": {
    "embedding": "qwen/qwen3-embedding-8b",
    "reranker": "voyageai/rerank-2.5",
    "generator": "qwen/qwen3-30b-a3b-instruct-2507",
    "verifier": "qwen/qwen3-30b-a3b-instruct-2507"
  },
  "collections": {
    "evidenceAlias": "municipal_evidence_current",
    "catalogAlias": "municipal_catalog_current",
    "previewCollection": "municipal_source_previews",
    "retainVersions": 2
  },
  "retrieval": {
    "denseCandidates": 40,
    "sparseCandidates": 40,
    "rrfK": 60,
    "maxPerDocument": 3,
    "rerankCandidates": 40,
    "finalEvidence": 16
  },
  "thresholds": {
    "minimumRerankScore": 0.22,
    "ambiguityScoreRatio": 0.88,
    "clarificationMinimumScore": 0.6,
    "supportedConfidence": 0.78
