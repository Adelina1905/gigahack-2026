# Copy to .env and fill in the secrets. .env is git-ignored; never commit it.

# PostgreSQL (docker compose + Spring Boot)
POSTGRES_DB=smart_city
POSTGRES_USER=smart_city_app
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433

# Qdrant vector database (docker compose + Python service)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Python LLM/RAG service (OpenRouter provides chat, embeddings and reranking)
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key

# live (default) calls the real AI; demo needs no API key or Qdrant index.
CHAT_MODE=live

# Java gateway
LLM_SERVICE_URL=http://127.0.0.1:8000
SERVER_PORT=8081

# Optional: municipal corpus API collection (fetch_municipal_corpus.py / run_all.py --collect)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
